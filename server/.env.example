# Database
DATABASE_URL=postgresql://user:password@host:5432/truetone

# Server
PORT=3000

# CORS (comma-separated list of allowed origins for production)
# Defaults to http://127.0.0.1:5173 in dev
CORS_ORIGIN=http://127.0.0.1:5173

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here

# Cloudinary (free tier: 25GB storage, 25GB bandwidth)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Sarvam AI keys (comma-separated for rotation; free tier: 1000 mins/month)
SARVAM_API=key1,key2

# OpenRouter (free tier: various free models, pay-as-you-go)
OPEN_ROUTER_API=sk-or-v1-your-key
